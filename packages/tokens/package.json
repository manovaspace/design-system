{
  "name": "@manovaspace/tokens",
  "version": "0.1.2",
  "description": "Design tokens, semantic CSS variables, and font assets for @manovaspace/ui",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovaspace/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/manovaspace/design-system/issues"
  },
  "homepage": "https://manovaspace.github.io/docs/design-system/packages/tokens/",
  "scripts": {
    "prepublishOnly": "node ../../scripts/assert-publishable-deps.mjs",
    "codegen": "node scripts/codegen.mjs",
    "build": "bun codegen && tsup && bun build:css",
    "build:css": "mkdir -p dist && cp src/css/*.css dist/ && cp src/fonts.css dist/fonts.css && cp src/css/tokens.css dist/tokens.css && cp src/default.json dist/default.json && node scripts/copy-fonts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist fonts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./semantic.css": "./dist/semantic.css",
    "./colors.css": "./dist/colors.css",
    "./default.json": "./dist/default.json",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0"
  },
  "devDependencies": {
    "@manovaspace/build": "file:../../../ts/packages/build",
    "@manovaspace/tsconfig": "^0.1.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
