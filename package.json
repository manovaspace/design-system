{
  "name": "manovaspace-design-system",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "storybook": "bun --filter @manovaspace/storybook storybook",
    "build-storybook": "bun --filter @manovaspace/storybook build-storybook",
    "lint": "biome check .",
    "check:ds": "bash scripts/check-ds.sh",
    "quality": "bun lint && bun check:ds",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@changesets/cli": "^2.29.5",
    "@types/node": "^26.1.0",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
