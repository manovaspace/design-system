{
  "name": "@manovaspace/devtools",
  "version": "0.0.5",
  "description": "Development-only design system toolbar and token editor for Next.js apps",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "devtools",
    "design-system",
    "nextjs",
    "development"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovaspace/design-system.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/manovaspace/design-system/issues"
  },
  "homepage": "https://manovaspace.github.io/docs/design-system/packages/devtools/",
  "scripts": {
    "prepublishOnly": "bun ../../scripts/assert-publishable-deps.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./slot": {
      "types": "./dist/slot/index.d.ts",
      "development": "./dist/slot/index.js",
      "default": "./dist/slot/index.prod.js"
    },
    "./next": {
      "types": "./dist/next/theme-route.d.ts",
      "import": "./dist/next/theme-route.js"
    },
    "./styles.css": "./src/styles/devtools.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "dependencies": {
    "@manovaspace/tokens": "^0.1.2",
    "@manovaspace/ui": "^0.2.2"
  },
  "devDependencies": {
    "@manovaspace/build": "^0.1.0",
    "@manovaspace/tsconfig": "^0.1.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^3.2.6"
  },
  "engines": {
    "node": ">=24"
  }
}
