{
  "name": "@manovaspace/tokens",
  "version": "1.0.0",
  "description": "Design tokens, semantic CSS variables, and font assets for @manovaspace/ui",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "design-tokens",
    "css-variables",
    "tailwind",
    "theming"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manovaspace/design-system.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/manovaspace/design-system/issues"
  },
  "homepage": "https://manovaspace.github.io/docs/design-system/packages/tokens/",
  "scripts": {
    "prepublishOnly": "bun ../../scripts/assert-publishable-deps.mjs",
    "codegen": "bun scripts/codegen.mjs",
    "build": "bun run codegen && tsup && bun run build:css",
    "build:css": "mkdir -p dist && cp src/css/*.css dist/ && cp src/fonts.css dist/fonts.css && cp src/css/tokens.css dist/tokens.css && cp src/default.json dist/default.json && bun scripts/copy-fonts.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:api": "bun ../../scripts/api-report.mjs check -c api-extractor.json",
    "update:api": "bun ../../scripts/api-report.mjs update -c api-extractor.json",
    "check:package": "publint && attw --pack .",
    "clean": "rm -rf dist fonts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./fonts.css": "./dist/fonts.css",
    "./semantic.css": "./dist/semantic.css",
    "./colors.css": "./dist/colors.css",
    "./default.json": "./dist/default.json",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/vazirmatn": "^5.3.0"
  },
  "devDependencies": {
    "@manovaspace/build": "^0.1.0",
    "@manovaspace/tsconfig": "^0.1.2",
    "@types/node": "^26.6.6",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
