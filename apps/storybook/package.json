{
  "name": "@manovaspace/storybook",
  "version": "0.0.14",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 10027 --no-open",
    "build-storybook": "storybook build -o storybook-static",
    "test:stories": "vitest run --project storybook",
    "playwright:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf storybook-static"
  },
  "dependencies": {
    "@manovaspace/tokens": "^1.0.0",
    "@manovaspace/ui": "^1.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0"
  },
  "devDependencies": {
    "@manovaspace/devtools": "^0.0.17",
    "@manovaspace/tsconfig": "^0.1.2",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-themes": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "framer-motion": "^14.9.0",
    "playwright": "^1.65.1",
    "storybook": "^10.6.5",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "catalog:"
  }
}
