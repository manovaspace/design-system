{
  "name": "manovaspace-design-system",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "storybook": "bun --filter @manovaspace/storybook storybook",
    "build-storybook": "bun --filter @manovaspace/storybook build-storybook",
    "lint": "biome check .",
    "check:ds": "bash scripts/check-ds.sh",
    "quality": "bun run lint && bun run check:ds",
    "format": "biome format --write .",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo build && changeset publish",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "^2.29.5",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "typescript": "^6.0.3",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/cli": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "next": "^16.2.10",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^26.1.0",
      "@biomejs/biome": "^2.5.5",
      "tsup": "^8.5.1",
      "vitest": "^3.2.6",
      "tw-animate-css": "^1.4.0"
    }
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "sharp"
  ]
}
